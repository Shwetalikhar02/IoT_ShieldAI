# ─────────────────────────────────────────────────────────────────────────────
# IoT ShieldAI — Environment Variables Template
# Copy this file to .env and populate the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Values: development | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Values: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── LLM Provider (pluggable) ──────────────────────────────────────────────────
# Values: mock | openai | anthropic | gemini | deepseek
LLM_PROVIDER=mock
# true = offline canned responses (demo/CI)
LLM_MOCK=true
# false = template-only, nothing leaves the machine
SEND_CODE_TO_EXTERNAL_LLM=true

# LLM API (Never commit real credentials!)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.anthropic.com

# Model tiers
# classification, explanation wording
LLM_MODEL_FAST=claude-haiku-5-5
# patch generation (Tier 2)
LLM_MODEL_STRONG=claude-sonnet-5-5
# Tier 3, third attempt only
LLM_MODEL_ESCALATION=claude-opus-5-5
# legacy alias
LLM_MODEL=claude-haiku-5-5

LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── Classifier ────────────────────────────────────────────────────────────────
CLASSIFIER_CONFIDENCE_THRESHOLD=0.75

# ── Repair loop ───────────────────────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=3
MAX_USER_REFINEMENTS=5

# ── No-cheating check ─────────────────────────────────────────────────────────
NOCHEAT_MIN_STATEMENT_RETENTION=0.7
NOCHEAT_MAX_LINES_OUTSIDE_SPAN=3

# ── Sandbox / Compiler ────────────────────────────────────────────────────────
SANDBOX_DOCKER_IMAGE=iot-shieldai-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_NETWORK_DISABLED=true
# Values: gcc | clang
COMPILER=gcc
ASAN_OPTIONS=halt_on_error=0:detect_leaks=1

# ── Verification Mode ────────────────────────────────────────────────────────
# Values: local | sandbox
# local = subprocess inside backend container (default)
# sandbox = dedicated hardened container
VERIFICATION_MODE=local

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=c,cpp,h,hpp,zip
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# ── Datasets ──────────────────────────────────────────────────────────────────
# In Docker: /datasets. Locally: auto-detected relative to project root.
DATASETS_DIR=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./shieldai.db
