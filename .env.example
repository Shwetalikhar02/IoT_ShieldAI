# ─────────────────────────────────────────────────────────────────────────────
# IoT ShieldAI — Environment Variables Template
# Copy this file to .env and populate the real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── LLM Provider (pluggable) ──────────────────────────────────────────────────
# Set LLM_PROVIDER to one of: openai | deepseek | codellama_local | ollama
LLM_PROVIDER=deepseek

# OpenAI-compatible endpoint (works for DeepSeek, OpenRouter, local vLLM)
LLM_API_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-coder-33b-instruct

# For local/Ollama models (no API key needed):
# LLM_API_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=codellama:13b-code

LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ── Sandbox / Compiler ────────────────────────────────────────────────────────
SANDBOX_DOCKER_IMAGE=iot-shieldai-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=30
COMPILER=gcc                 # gcc | clang
ASAN_OPTIONS=halt_on_error=0:detect_leaks=1

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_EXTENSIONS=c,cpp,h,hpp

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (future) ─────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./shieldai.db
